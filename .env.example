# Copy to .env and fill in. NEVER commit a real .env.
# NO API KEYS HERE, EVER. Keys live only in the Secure Vault and are used
# solely through the registered connector CLIs (custom.meko / custom.gemini).
# This file holds only non-secret settings.

# Datapack for the official runs (created in Meko Cloud, e.g. orderloop-run-b1).
MEKO_DATAPACK_ID=
# Optional: override the MCP endpoint (default https://mcp.mekodata.ai/mcp).
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
# Optional: override the connector CLI paths (defaults point at the
# registered custom.meko / custom.gemini helpers).
# MEKO_CLI=~/workspace/custom-connectors/custom.meko/bin/client.py
# GEMINI_CLI=~/workspace/custom-connectors/custom.gemini/bin/client.py

# Locked model for all runs (verified working 26 Nov 2026; gemini-2.5-flash
# is retired for new users).
GEMINI_MODEL=gemini-3.5-flash-lite

# Demo server / harness options (no secrets here).
LLM_KIND=auto
MEKO_KIND=auto
HITL_MODE=manual
